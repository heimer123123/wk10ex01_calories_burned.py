<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="wk10ex01_calories_burned"/>
        <attribute name="authors" value="USER"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-20 11:39:16 PM"/>
        <attribute name="created" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0wOS0yMDswOTowMzo0NCBQTTsyNjc4"/>
        <attribute name="edited" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0wOS0yMDsxMTozOToxNiBQTTsyOzI3ODg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sessions" type="Integer" array="False" size=""/>
            <declare name="index" type="Integer" array="False" size=""/>
            <declare name="activityCode" type="Integer" array="False" size=""/>
            <declare name="minutes" type="Integer" array="False" size=""/>
            <declare name="sessionCalories" type="Real" array="False" size=""/>
            <declare name="totalCalories" type="Real" array="False" size=""/>
            <declare name="caloriesList" type="Real" array="True" size="10"/>
            <assign variable="totalCalories" expression="0"/>
            <input variable="sessions"/>
            <assign variable="index" expression="1"/>
            <while expression="index &lt;= sessions">
                <input variable="activityCode"/>
                <input variable="minutes"/>
                <assign variable="sessionCalories" expression="ComputeSessionCalories(activityCode, minutes)"/>
                <assign variable="caloriesList[index - 1]" expression="sessionCalories"/>
                <assign variable="totalCalories" expression="totalCalories + sessionCalories"/>
                <assign variable="index" expression="index + 1"/>
            </while>
            <output expression="&quot;Total calories burned: &quot; &amp; totalCalories" newline="True"/>
        </body>
    </function>
    <function name="ComputeSessionCalories" type="Real" variable="sessionCalories">
        <parameters>
            <parameter name="code" type="Integer" array="False"/>
            <parameter name="mins" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="sessionCalories" type="Real" array="False" size=""/>
            <if expression="code == 1">
                <then>
                    <assign variable="sessionCalories" expression="4 * mins"/>
                </then>
                <else>
                    <if expression="code == 2">
                        <then>
                            <assign variable="sessionCalories" expression="10 * mins"/>
                        </then>
                        <else>
                            <if expression="code == 3">
                                <then>
                                    <assign variable="sessionCalories" expression="8 * mins"/>
                                </then>
                                <else>
                                    <assign variable="sessionCalories" expression="0"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
